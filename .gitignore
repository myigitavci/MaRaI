# Environments
.env
.venv
env/
venv/
ENV/

# Jupyter
.ipynb_checkpoints/

# IDE
.idea/
.vscode/
*.swp
*.swo
weights/

# Logs & Experiments
**/wandb/
**/logs/

# Model weights (store links, not files)
*.pt
*.pth
*.ckpt
*.bin
*.safetensors

# Data
*.nii
*.nii.gz
*.dcm
*.npy
*.npz

# Misc
core.*
*.pdf
**/_*
sync.sh
gpu*sync.sh
*.jsonl
